{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/collateral/**",
              "components/core/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Infant|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Infant, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|outline|gold|neutral)$/]",
        "message": "<Badge> tone must be one of 'sage' | 'outline' | 'gold' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|keyline|label|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, keyline, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:panel|wash|tinted)$/]",
        "message": "<Callout> tone must be one of 'panel' | 'wash' | 'tinted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|after|replacedWith|key|ref|className|style|children)$/]",
        "message": "<ComparisonRow> doesn't accept that prop. Declared props: before, after, replacedWith."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclaimerFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|key|ref|className|style|children)$/]",
        "message": "<DisclaimerFooter> doesn't accept that prop. Declared props: variant, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclaimerFooter'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|bga)$/]",
        "message": "<DisclaimerFooter> variant must be one of 'standard' | 'bga'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclaimerFooter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<DisclaimerFooter> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoldRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|endcaps|align|key|ref|className|style|children)$/]",
        "message": "<GoldRule> doesn't accept that prop. Declared props: width, endcaps, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoldRule'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<GoldRule> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|showTagline|src|alt|colorway|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, showTagline, src, alt, colorway, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark|lockup)$/]",
        "message": "<Logo> variant must be one of 'mark' | 'lockup'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='colorway'] > Literal[value!=/^(?:green|white|green-on-dark)$/]",
        "message": "<Logo> colorway must be one of 'green' | 'white' | 'green-on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessFlow'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|orientation|circleSize|tone|key|ref|className|style|children)$/]",
        "message": "<ProcessFlow> doesn't accept that prop. Declared props: steps, orientation, circleSize, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessFlow'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<ProcessFlow> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessFlow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|on-dark)$/]",
        "message": "<ProcessFlow> tone must be one of 'default' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:italic|tone|size|attribution|children|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: italic, tone, size, attribution, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|on-dark|on-wash)$/]",
        "message": "<PullQuote> tone must be one of 'default' | 'on-dark' | 'on-wash'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PullQuote> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SageEffectBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tagline|height|key|ref|className|style|children)$/]",
        "message": "<SageEffectBar> doesn't accept that prop. Declared props: label, tagline, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|font|tone|align|children|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: as, font, tone, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='font'] > Literal[value!=/^(?:sans|serif)$/]",
        "message": "<SectionLabel> font must be one of 'sans' | 'serif'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|on-dark)$/]",
        "message": "<SectionLabel> tone must be one of 'default' | 'accent' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<SectionLabel> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TwoColumnFramework'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|leftHeader|rightHeader|thirdHeader|key|ref|className|style|children)$/]",
        "message": "<TwoColumnFramework> doesn't accept that prop. Declared props: rows, leftHeader, rightHeader, thirdHeader."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
